{
  "name": "Real-Time Fraud Alert Watcher",
  "description": "Fires fraudAlertWatcher on every Rental create/update to detect no-invoice active rentals, blacklisted customers, deep discounts, and cancel+resell patterns. Sends immediate SMS+email to fraud alert contacts naming the responsible employee.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Rental"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "real_time_fraud_alert_watcher",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fraudAlertWatcher",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "fraudAlertWatcher"
  }
}